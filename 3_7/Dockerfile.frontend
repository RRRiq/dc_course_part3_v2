
FROM node:16-alpine

WORKDIR /app

COPY code/example-frontend .

ENV REACT_APP_BACKEND_URL=http://localhost:8080

RUN npm install && \
    npm run build && \
    npm install -g serve && \
    rm -rf src node_modules /root/.npm && \
    adduser -D appuser && \
    chown -R appuser:appuser /app

USER appuser

EXPOSE 5001

CMD ["serve", "-s", "-l", "5001", "build"]
